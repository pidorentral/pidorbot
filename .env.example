BOT_TOKEN=123456789:replace_with_telegram_bot_token
TG_ADMIN_IDS=123456789,5467845867458

DATABASE_URL=postgresql://username:password@hostname:port/database_name
ENCRYPTION_KEY=replace_with_random_encryption_key

FUNPAY_GOLDEN_KEY=replace_with_funpay_cookie_value
FUNPAY_POLL_INTERVAL_MS=5000
FUNPAY_CHAT_POLL_MS=5000
FUNPAY_POLLING_ENABLED=false

RENTAL_RENEWAL_GRACE_MS=120000
RENTAL_EXPIRY_CHECK_MS=30000
RENTAL_CLEANUP_RETRY_INITIAL_MS=30000
RENTAL_CLEANUP_RETRY_MAX_MS=3600000
RENTAL_CLEANUP_LEASE_MS=75000

# Password rotation is optional; device deauthorization remains mandatory.
ENABLE_PASSWORD_CHANGE=false

# Optional: persistent Playwright profile already logged into Steam.
# Set headless=false during one-time interactive login, then switch to true.
STEAM_BROWSER_PROFILE_DIR=
STEAM_BROWSER_HEADLESS=true

PG_MAX_CLIENTS=10
PG_IDLE_TIMEOUT=30000

SMOKE_SHARED_SECRET=