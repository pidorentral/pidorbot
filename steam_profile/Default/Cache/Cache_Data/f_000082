u0430\u0448 \u043A\u0440\u0438\u043A. \u0418 \u044D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0448\u0435\u0441\u0442\u044C \u0434\u043D\u0435\u0439 \u0432\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u0438 \u0434\u0435\u043B\u0430\u0435\u0442\u0435, \u0447\u0442\u043E \u043A\u0440\u0438\u0447\u0438\u0442\u0435. \u0412\u0430\u0448 \u043E\u0442\u0431\u043E\u0440\u043D\u044B\u0439 \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439 \u0434\u0435\u043D\u044C (\u0441\u0435\u0439\u0447\u0430\u0441 \u0432\u044B \u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0443\u0435\u0442\u0435\u0441\u044C \xAB\u0412\u043E\u0437\u0434\u0443\u0448\u043A\u043E\u043C\xBB \u2014 \u0431\u044E\u0434\u0436\u0435\u0442\u043D\u043E\u0439 \u0434\u044B\u0445\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u043C\u0435\u0441\u044C\u044E \u0441\u043E \u0441\u0432\u0438\u043D\u043E\u0439 \u043E\u0442\u0434\u0443\u0448\u043A\u043E\u0439). \u0414\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0438 \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0438. \u0412\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0440\u0435\u0439\u0444\u0443\u0435\u0442\u0435. \u0414\u0440\u0435\u0439\u0444\u0443\u0435\u0442\u0435 \u043F\u043E \u044D\u0442\u043E\u043C\u0443 \u043F\u044B\u043B\u044C\u043D\u043E\u043C\u0443 \u0431\u0435\u0437\u0434\u043E\u0440\u043E\u0436\u044C\u044E \u043F\u043E\u0434 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u043C \u043A\u043E\u0441\u043C\u043E\u0441. \u041A\u0430\u043A \u0432\u0434\u0440\u0443\u0433... \\n     \u0412\u0430\u043C \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u0432\u044B \u0441\u043B\u044B\u0448\u0438\u0442\u0435 \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u043C\u0438\u043C\u043E \u043A\u0440\u0438\u043A\u0430, \u043D\u043E \u0447\u0442\u043E\u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430, \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044C \u043A\u0440\u0438\u0447\u0430\u0442\u044C, \u0430 \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0441\u043B\u0443\u0447\u0438\u0442\u0441\u044F. \u0412 \u0438\u043B\u043B\u044E\u043C\u0438\u043D\u0430\u0442\u043E\u0440\u0435 \u0432\u044B \u0432\u0438\u0434\u0438\u0442\u0435 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0444\u043B\u043E\u0442 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043A\u043E\u0440\u0430\u0431\u043B\u0435\u0439, \u0432\u043E\u0437\u0433\u043B\u0430\u0432\u043B\u044F\u0435\u043C\u044B\u0439 \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0444\u043B\u043E\u0442\u043E\u043C \u043B\u0438\u043D\u043A\u043E\u0440\u043E\u0432. \u041D\u0430 \u0432\u0430\u0448\u0435\u043C \u043B\u043E\u0431\u043E\u0432\u043E\u043C \u0441\u0442\u0435\u043A\u043B\u0435 \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442 \u0437\u0435\u043B\u0451\u043D\u043E\u0435 \u043B\u0438\u0446\u043E. \xAB\u041C\u042B \u0421\u041B\u042B\u0428\u0410\u041B\u0418 \u0412\u0410\u0428\u0418 \u041A\u0420\u0418\u041A\u0418\xBB, \u2014 \u043E\u0440\u0451\u0442 \u043B\u0438\u0446\u043E. \xAB\u0412 \u041A\u041E\u0421\u041C\u041E\u0421\u0415 \u0412\u0421\u0415 \u0421\u041B\u042B\u0428\u0410\u0422 \u0412\u0410\u0428\u0418 \u041A\u0420\u0418\u041A\u0418, \u0415\u0421\u041B\u0418 \u0412\u042B \u041D\u0410\u0416\u0418\u041C\u0410\u0415\u0422\u0415 \u041D\u0410 \u042D\u0422\u0423 \u041A\u041D\u041E\u041F\u041A\u0423\xBB. \u0418\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u044F\u043D\u0438\u043D \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0432\u044B \u0436\u0430\u043B\u0438 \u0432\u0441\u0435 \u0448\u0435\u0441\u0442\u04